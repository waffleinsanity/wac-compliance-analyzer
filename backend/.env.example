# Investigator LLM — Google Gemini (free tier, OpenAI-compatible)
# Get a key: https://aistudio.google.com/apikey
LLM_ENABLED=true
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
LLM_TIMEOUT_SECONDS=90
# Keep false for fast IR drafts (PDF matching only). Set true to enrich with Gemini.
LLM_FOR_INVESTIGATE=false

# Optional local Ollama instead:
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.2

# Optional OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Auth / JWT — change SECRET_KEY in any shared or production deployment
SECRET_KEY=wac-compliance-dev-secret-change-in-production

# Public password registration — default false (safer for shared hosts).
# Set true only for local open signup.
ALLOW_PUBLIC_REGISTRATION=false

# Google Sign-In (server-side OAuth)
# Authorized JavaScript origins: http://localhost:5173
# Authorized redirect URIs: http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override (default = {APP_PUBLIC_URL}/api/auth/google/callback)
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Bootstrap admin created on startup when no admin exists
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeAdmin1!
ADMIN_BOOTSTRAP_EMAIL=admin@localhost

# Public UI URL (like NEXTAUTH_URL) — used for OAuth redirect + password-reset emails
APP_PUBLIC_URL=http://localhost:5173

# Optional SMTP for forgot-password emails (if unset, reset links are printed to the API console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Auth abuse controls (requests per 15-minute window per IP)
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_REGISTER=8
AUTH_RATE_LIMIT_LOGIN=30
AUTH_RATE_LIMIT_FORGOT=5
AUTH_RATE_LIMIT_GOOGLE=30
